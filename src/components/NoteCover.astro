---
interface Props { cover: string; day?: number; }
const { cover, day } = Astro.props;
---
{cover === 'web' ? (<div class="cover cover-web" aria-hidden="true"><span class="cover-badge">WEB DEVELOPMENT</span><span class="cover-code">&lt;/&gt;</span><div class="tech-cube"><svg><use href="#art-vue"/></svg></div><div class="spring-cube"><svg><use href="#art-leaf"/></svg></div><div class="cover-title">Vue +<br>Spring Boot<small>从基础到项目实践</small></div></div>
) : cover === 'neural' ? (<div class="cover cover-neural" aria-hidden="true"><span class="cover-badge">DEEP LEARNING</span>
<svg class="network-art" viewBox="0 0 240 210"><g fill="none" stroke="#d5dcff" stroke-width="1.1" opacity=".45"><path d="M67 61 131 29 197 66M67 61 131 88 197 66M67 61 131 149 197 66M67 132 131 29 197 137M67 132 131 88 197 137M67 132 131 149 197 137"/><path d="M26 95 67 61M26 95l41 37M197 66l28 36-28 35"/></g><g fill="#c6ccff" stroke="#ffffff75" stroke-width="2"><circle cx="67" cy="61" r="12"/><circle cx="67" cy="132" r="12"/><circle cx="131" cy="29" r="10"/><circle cx="131" cy="88" r="14"/><circle cx="131" cy="149" r="10"/><circle cx="197" cy="66" r="13"/><circle cx="197" cy="137" r="13"/></g><g fill="white"><circle cx="26" cy="95" r="6"/><circle cx="225" cy="102" r="6"/><circle cx="131" cy="88" r="5"/></g><circle cx="131" cy="88" r="24" fill="none" stroke="#ffffff24"/><g fill="#fff6"><circle cx="43" cy="19" r="2"/><circle cx="180" cy="22" r="3"/><circle cx="224" cy="170" r="2"/></g></svg>
<div class="cover-title">神经网络<small>从原理到实现</small></div></div>
) : (
<div class="cover cover-sky" aria-hidden="true"><span class="cover-badge">JAVA PROJECT NOTES</span><span class="day-watermark">{String(day || 1).padStart(2, '0')}</span><div class="sky-dish"><svg viewBox="0 0 80 80"><path d="M14 50a26 26 0 0 1 52 0" fill="none" stroke="currentColor" stroke-width="5"/><path d="M8 54h64M20 63h40M40 19v5" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"/><circle cx="40" cy="15" r="4" fill="currentColor"/></svg></div><div class="cover-title">苍穹外卖<small>DAY {String(day || 1).padStart(2, '0')} · 项目学习笔记</small></div></div>
)}
